# Auto-detect text files and force LF line endings
* text=auto eol=lf

# Markdown and Python files - explicit LF
*.md text eol=lf
*.py text eol=lf
*.zcml text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.example text eol=lf
*.env text eol=lf
Dockerfile text eol=lf

# Binary files - do not touch
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.whl binary
*.egg binary
*.tar.gz binary
*.gz binary
*.zip binary
*.db binary
*.fs binary
